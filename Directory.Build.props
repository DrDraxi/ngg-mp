<Project>
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.1.0</Version>
    <!-- Path to the game's managed assemblies. Override on the command line:
         dotnet build -p:GameManagedDir="C:\...\Normal Golf Game_Data\Managed" -->
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(MSBuildThisFileDirectory)lib\game</GameManagedDir>
  </PropertyGroup>
</Project>
